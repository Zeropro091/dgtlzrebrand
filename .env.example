# =============================================================================
# DGTLZ ECOSYSTEM ENVIRONMENT CONFIGURATION
# =============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls & assistant modules.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Canonical URL where the frontend application is hosted.
# Used for self-referential links, OAuth callbacks, and API integrations.
APP_URL="http://localhost:3000"

# DISABLE_HMR: Set to 'true' in CI or resource-constrained server environments
# to prevent file-watcher CPU overhead.
DISABLE_HMR="false"

# PORT: Port used by the Node.js Express Command Deck server (default: 4000)
PORT="4000"
